# explorateur.grn — un agent qui explore un dossier de code et en fait le rapport.
#
#   export ANTHROPIC_API_KEY=…
#   grenat run --log examples/explorateur.grn crates/grenat_parser

model :smart, provider: :anthropic, name: "claude-opus-5", effort: :low
model :fast,  provider: :anthropic, name: "claude-haiku-4-5"

enum Maturity
  Prototype   ## code exploratoire, peu ou pas de tests
  Solide      ## structuré, testé
  Production  ## prêt à être déployé et maintenu
end

## Rapport d'exploration d'un dossier de code.
struct Report
  summary: String            ## ce que fait ce code, en trois phrases au plus
  files_read: Array(String)  ## chemins effectivement lus
  maturity: Maturity
  next_steps: Array(String)  ## deux ou trois suggestions concrètes
end

## Liste un dossier ; les sous-dossiers se terminent par `/`.
tool list_dir(path: String) -> Array(String) uses fs.read
  entries = Dir.list(path).reject { |name| name.start_with?(".") || name == "target" }
  entries.map { |name| if File.directory?("#{path}/#{name}") then "#{name}/" else name end }
end

## Lit un fichier texte (les `max_lines` premières lignes).
tool read_file(path: String, max_lines: Int = 200) -> String uses fs.read
  File.lines(path).take(max_lines).join("\n")
end

agent Explorer
  model :smart
  tools list_dir, read_file
  max_turns 15
  budget usd: 0.50

  instructions <<~I
    Tu explores un dossier de code source pour en écrire un rapport fidèle.
    Lis seulement les fichiers utiles : README, manifestes, points d'entrée, tests.
    N'invente rien : chaque affirmation doit venir d'un fichier lu.
  I

  on Explore(path: String) -> ~Report
    run "Explore le dossier `#{path}` et rédige ton rapport."
  end
end

## Présente un projet en une phrase percutante.
prompt pitch(summary: String) -> ~String using :fast
  user "Écris une seule phrase (200 caractères max) qui donne envie de découvrir ce projet : #{summary}"
end

def main(args: Array(String)) uses llm, fs.read
  path = args.first || "."
  report = spawn(Explorer).ask(Explore(path:))

  puts "## #{path} — #{report.maturity}"
  puts report.summary
  puts
  puts "Fichiers lus : #{report.files_read.join(", ")}"
  report.next_steps.each { |step| puts "- #{step}" }
  puts
  puts "> #{pitch(report.summary)}"
rescue BudgetExceeded => e
  warn "Budget épuisé : #{e.message}"
end
