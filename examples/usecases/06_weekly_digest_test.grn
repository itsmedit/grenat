require "./06_weekly_digest"

# tests never send email: the server's URL only has to be one
test "the week's new releases are summarized and sent" do
  mock_env({"SMTP_URL" => "smtp://smtp.test"})
  mock_http "GET https://api.github.com/repos/rust-lang/rust/releases*", json: [{html_url: "https://github.com/rust-lang/rust/releases/tag/1.95.0", name: "1.95.0"}]
  mock :fast, replies: [{headline: "Rust 1.95", bullets: ["Rust 1.95.0 is out"]}]
  main(["2026-09-28", "rust-lang/rust"])
  assert_equal "Watch 2026-09-28: Rust 1.95", Mail.deliveries.first["subject"]
end

test "after a crash before the email, the run resumes where it stopped" do
  mock_env({"SMTP_URL" => "smtp://smtp.test"})
  mock_http "GET https://api.github.com/repos/rust-lang/rust/releases*", json: [{html_url: "https://github.com/rust-lang/rust/releases/tag/1.96.0", name: "1.96.0"}]
  mock :fast, replies: [{headline: "Rust 1.96", bullets: ["Rust 1.96.0 is out"]}]
  mock_mail(raise: "SMTP down")
  assert_raises(MailError) { main(["2026-10-05", "rust-lang/rust"]) }
  mock_mail(raise: nil)
  # the model's one reply is spent: the summary comes from the journal
  main(["2026-10-05", "rust-lang/rust"])
  assert_equal "Watch 2026-10-05: Rust 1.96", Mail.deliveries.first["subject"]
  assert_equal 1, Http.requests.size
end
