# Code review of pull requests: GitHub's webhook wakes the program
# (`grenat serve`) when one is opened; the agent reads the diff and the
# files it needs, then posts one review comment.
model :smart, provider: :anthropic, name: "claude-opus-5"

enum Severity
  Blocker
  Major
  Minor
end

struct Finding
  path: String
  line: Int
  severity: Severity
  message: String  ## what is wrong and how to fix it
end

struct Review
  summary: String  ## two sentences at most
  findings: Array(Finding)
end

## GitHub's REST API.
module GitHub
  def self.headers(accept: String) -> Hash(String, String) uses env
    {"Authorization" => "Bearer #{Env.fetch("GITHUB_TOKEN")}", "Accept" => accept}
  end

  def self.diff(repo: String, pr: Int) -> ~String uses net("api.github.com"), env
    Http
      .get(
        "https://api.github.com/repos/#{repo}/pulls/#{pr}",
        headers: headers("application/vnd.github.diff"),
      )
      .body
  end

  def self.file(repo: String, path: String) -> ~String uses net("api.github.com"), env
    Http
      .get(
        "https://api.github.com/repos/#{repo}/contents/#{path}",
        headers: headers("application/vnd.github.raw"),
      )
      .body
  end

  def self.comment(repo: String, pr: Int, body: String) -> Int uses net("api.github.com"), env
    Http
      .post(
        "https://api.github.com/repos/#{repo}/issues/#{pr}/comments",
        json: {body:},
        headers: headers("application/json"),
      )
      .status
  end
end

## Reads a file of the repository, at the head of the pull request.
tool read_file(path: String) -> ~String uses net("api.github.com"), env
  GitHub.file("acme/app", path)
end

agent Reviewer
  model :smart
  tools read_file
  max_turns 15
  budget usd: 1.00
  instructions "You review pull requests. Report real problems only: bugs, security, missing tests."

  on ReviewPr(diff: String) -> ~Review
    run "Review this diff:\n#{diff}"
  end
end

def markdown(r: Review) -> String
  lines = r.findings.map { |f| "- **#{f.severity}** `#{f.path}:#{f.line}` #{f.message}" }
  "#{r.summary}\n\n#{lines.join("\n")}"
end

def main(args: Array(String)) uses llm, net("api.github.com"), env
  repo = args[0]
  pr = args[1].to_i
  review = spawn(Reviewer).ask(ReviewPr(diff: GitHub.diff(repo, pr)))
  safe = review.check { |r| r.findings.all? { |f| f.line > 0 } }?
  GitHub.comment(repo, pr, markdown(safe))
end

# `grenat serve examples/usecases/02_code_review.grn`, with this URL as the
# repository's webhook (event: pull requests)
on_webhook "/github", secret: Env.fetch("GITHUB_WEBHOOK_SECRET"), signature: :github do |req|
  event = req.json.check { |e| e["pull_request"] && e["repository"] }?
  if event["action"] == "opened"
    main([event["repository"]["full_name"], event["pull_request"]["number"].to_s])
  end
  "ok"
end
