# An agent using third-party services (Linear, Notion) through their MCP
# servers: their tools come from the servers, none is written by hand.
model :smart, provider: :anthropic, name: "claude-opus-5"

mcp :linear, url: "https://mcp.linear.app/mcp", headers: {
  "Authorization" => "Bearer #{Env.fetch("LINEAR_TOKEN")}",
}
mcp :notion, url: "https://mcp.notion.com/mcp", headers: {
  "Authorization" => "Bearer #{Env.fetch("NOTION_TOKEN")}",
}

struct Issue
  id: String
  title: String
end

agent Pm
  model :smart
  # tools that change things (creating an issue) are approved by a human
  tools mcp(:linear), mcp(:notion)
  max_turns 20
  tool_timeout 30
  budget usd: 1.00
  instructions "You turn product specs into Linear issues, without duplicates."

  on Plan(spec: String) -> ~Array(Issue)
    run "Create the missing issues for the spec titled: #{spec}"
  end
end

def main(args: Array(String)) uses llm, mcp, human
  Runtime.on_approval { |req| Cli.confirm(req.message) }
  issues = spawn(Pm).ask(Plan(spec: args.join(" "))).trust!
  issues.each { |i| puts "#{i.id} #{i.title}" }
end
