# Data agent: a question in plain language, SQL written by the model,
# checked read-only, run with parameters, then explained.
model :smart, provider: :anthropic, name: "claude-opus-5"
model :fast, provider: :anthropic, name: "claude-haiku-4-5"

struct Query
  sql: String          ## one SELECT statement, standard SQL
  explanation: String  ## what the query computes
end

## Writes the SQL answering a question.
prompt to_sql(question: String, schema: String) -> ~Query using :smart
  system "You write read-only SQL queries. Schema:\n#{schema}"
  user question
end

## Explains a result to a business user.
prompt explain(question: String, rows: String) -> ~String using :fast
  user "Question: #{question}\nResult (JSON): #{rows}\nAnswer in two sentences."
end

def read_only?(sql: String) -> Bool
  s = sql.strip.downcase
  writes = ["insert", "update", "delete", "drop", "alter", "create", "grant", ";"]
  s.start_with?("select") && writes.none? { |w| s.include?(w) }
end

## The answer to `question`, from `db` whose tables `schema` describes.
def answer(db: Database, schema: String, question: String) -> ~String uses llm, db.read
  query = to_sql(question, schema).check { |q| read_only?(q.sql) }?
  rows = db.query(query.sql)
  explain(question, Json.dump(rows.first(50)))
end

def main(args: Array(String)) uses llm, db.read, env, fs.read
  db = Db.connect(Env.fetch("DATABASE_URL"))
  puts answer(db, File.read("schema.sql"), args.join(" "))
end
