# Conversational assistant with memory: a Conversation keeps the turns,
# compacts the older ones into a summary, and is saved between sessions.
model :fast, provider: :anthropic, name: "claude-haiku-4-5"

MEMORY = "memory.json"

def main uses llm, human, fs.read, fs.write
  chat = Conversation.load(MEMORY, model: :fast, system: "You are a helpful assistant.", keep: 10)
  loop do
    line = Cli.ask("> ")
    break if line.nil? || line == "exit"
    puts chat.say(line)
  end
  chat.save(MEMORY)
end
