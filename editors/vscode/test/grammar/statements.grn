workflow publish(topic: String) uses llm, net("blog.acme.io"), human
# <-------- storage.type.function.workflow.grenat
#        ^^^^^^^ entity.name.function.grenat
#                                    ^^^ support.constant.effect.grenat
  post = step(:draft) { summarize(topic).trust! }
#        ^^^^ keyword.other.declaration.grenat
#             ^^^^^^ constant.other.symbol.grenat
  step(:review) { approve! "Publish “#{post.title}”?" }
# ^^^^ keyword.other.declaration.grenat
#                 ^^^^^^^^ support.function.builtin.grenat
end

def area(s: Shape) -> Float
  case s
# ^^^^ keyword.control.grenat
  in Circle(r) then 3.14159 * r * r
# ^^ keyword.control.grenat
#    ^^^^^^ entity.name.type.grenat
#              ^^^^ keyword.control.grenat
#                   ^^^^^^^ constant.numeric.grenat
#                           ^ keyword.operator.arithmetic.grenat
  end
end

def total(xs: Array(Int)) -> Int
  xs.each do |x, acc|
#         ^^ keyword.control.grenat
#            ^ punctuation.separator.variable.grenat
#             ^ variable.parameter.block.grenat
#                ^^^ variable.parameter.block.grenat
    return nil unless x&.positive? && acc != 0
#   ^^^^^^ keyword.control.grenat
#          ^^^ constant.language.grenat
#              ^^^^^^ keyword.control.grenat
#                      ^^ keyword.operator.safe-navigation.grenat
#                                  ^^ keyword.operator.logical.grenat
#                                         ^^ keyword.operator.comparison.grenat
  end?
# ^^^ keyword.control.grenat
  begin
# ^^^^^ keyword.control.grenat
    raise ArgumentError, "msg"
#   ^^^^^ keyword.control.grenat
#         ^^^^^^^^^^^^^ entity.name.type.grenat
  rescue KeyError, ArgumentError => e
# ^^^^^^ keyword.control.grenat
#                                ^^ keyword.operator.arrow.grenat
  ensure
# ^^^^^^ keyword.control.grenat
  end
  enqueue(:publish, "rust", in: 1.hour)
# ^^^^^^^ support.function.builtin.grenat
#                           ^^^ constant.other.symbol.hashkey.grenat - keyword.control.grenat
#                               ^ constant.numeric.grenat
#                                 ^^^^ keyword.other.unit.grenat
  limit = 3
# ^^^^^ - keyword.other.declaration.grenat
  "it's \"quoted\"\n"
#       ^^ constant.character.escape.grenat
#                 ^^ constant.character.escape.grenat
end

